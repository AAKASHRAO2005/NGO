# Server
NODE_ENV=production
PORT=5000

# MongoDB (Use MongoDB Atlas for production)
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/ngo_management

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=7d

# Default Admin (for seeder)
ADMIN_EMAIL=admin@ngo.org
ADMIN_PASSWORD=Admin@1234

# CORS
CLIENT_URL=https://your-domain.vercel.app

# Supabase
SUPABASE_URL=https://vubgjjghspspxhpkmvdr.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
SUPABASE_SECRET_KEY=your_supabase_secret_key
SUPABASE_JWKS_URL=https://vubgjjghspspxhpkmvdr.supabase.co/auth/v1/.well-known/jwks.json
